/**
 * WhiteSur Dark Theme for Rofi (macOS Spotlight style)
 * Designed to match WhiteSur GTK / Sway aesthetic
 */

* {
    /* WhiteSur Dark Palette */
    whitesur-bg:         rgba(43, 43, 43, 0.95);
    whitesur-border:     rgba(255, 255, 255, 0.12);
    whitesur-search-bg:  rgba(255, 255, 255, 0.08);
    whitesur-accent:     #3689e6;
    whitesur-fg:         #ffffff;
    whitesur-fg-dim:     #a6a6a6;
    whitesur-urgent:     #e9575a;

    background-color:    transparent;
    text-color:          @whitesur-fg;
    font:                "Vazirmatn UI NL, SF Pro Text, Fira Code, sans-serif 12";

    margin:              0px;
    padding:             0px;
    spacing:             0px;
}

window {
    transparency:        "real";
    background-color:    @whitesur-bg;
    border:              1px solid;
    border-color:        @whitesur-border;
    border-radius:       12px;
    width:               600px;
    location:            center;
    anchor:              center;
    x-offset:            0px;
    y-offset:            0px;
}

mainbox {
    padding:             14px;
    spacing:             8px;
    children:            [ inputbar, message, listview ];
}

inputbar {
    background-color:    @whitesur-search-bg;
    border:              1px solid;
    border-color:        @whitesur-border;
    border-radius:       8px;
    padding:             8px 12px;
    spacing:             10px;
    children:            [ icon-search, prompt, entry ];
}

icon-search {
    expand:              false;
    filename:            "system-search";
    size:                20px;
    vertical-align:      0.5;
}

prompt {
    enabled:             true;
    text-color:          @whitesur-accent;
    vertical-align:      0.5;
}

entry {
    background-color:    transparent;
    text-color:          @whitesur-fg;
    placeholder:         "Search applications...";
    placeholder-color:   @whitesur-fg-dim;
    cursor:              text;
    vertical-align:      0.5;
}

message {
    padding:             8px 12px;
    border-radius:       8px;
    background-color:    @whitesur-search-bg;
    margin:              4px 0px;
}

textbox {
    text-color:          @whitesur-fg;
    vertical-align:      0.5;
}

listview {
    columns:             1;
    lines:               8;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              vertical;
    reverse:             false;
    fixed-height:        false;
    spacing:             4px;
    margin:              4px 0px 0px 0px;
}

element {
    enabled:             true;
    padding:             6px 10px;
    spacing:             12px;
    border-radius:       8px;
    background-color:    transparent;
    cursor:              pointer;
}

element normal.normal {
    background-color:    transparent;
    text-color:          @whitesur-fg;
}

element normal.urgent {
    background-color:    @whitesur-urgent;
    text-color:          @whitesur-fg;
}

element normal.active {
    background-color:    transparent;
    text-color:          @whitesur-accent;
}

element selected.normal {
    background-color:    @whitesur-accent;
    text-color:          @whitesur-fg;
}

element selected.urgent {
    background-color:    @whitesur-urgent;
    text-color:          @whitesur-fg;
}

element selected.active {
    background-color:    @whitesur-accent;
    text-color:          @whitesur-fg;
}

element alternate.normal {
    background-color:    transparent;
    text-color:          @whitesur-fg;
}

element alternate.urgent {
    background-color:    @whitesur-urgent;
    text-color:          @whitesur-fg;
}

element alternate.active {
    background-color:    transparent;
    text-color:          @whitesur-accent;
}

element-icon {
    background-color:    transparent;
    text-color:          inherit;
    size:                28px;
    cursor:              inherit;
    vertical-align:      0.5;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}
