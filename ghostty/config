# font-family = "Noto Sans Mono"
font-family = "Fira Code"
font-size = 15

# Correct spacing and explicit opacity
background-opacity = 1

background = #141414
# background = #010b14

working-directory = home
window-inherit-working-directory = false

font-feature = -calt
font-feature = -liga
font-feature = -dlig

window-padding-x = 0
window-padding-y = 0

cursor-style = block
shell-integration = zsh
mouse-hide-while-typing = true
unfocused-split-opacity = 0.9

theme = Dark+
link-url = true
gtk-titlebar = false

